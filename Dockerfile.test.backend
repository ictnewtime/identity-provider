# Ambiente dei test di BACKEND (PHPUnit), separato da quello di sviluppo.
#
# Perche' esiste: finche' la suite girava nel container di sviluppo, condivideva con esso il
# database, il file .env e `bootstrap/cache/`. Da quella condivisione e' nato il difetto VDF11 —
# `migrate:fresh` sul database di lavoro. Qui la condivisione non c'e': l'ambiente e' suo, e il
# .env dell'host non viene ne' letto come autorevole ne' sovrascritto.
#
# NON ha un docker-compose: non gli serve. I test di backend girano su **sqlite in memoria**, che
# vive dentro il processo di PHP e muore con lui — nessun servizio deve restare su, quindi un
# comando basta (decisione D4). Il compose e' l'ambiente degli E2E: `docker-compose.test.yml`.
#
#     docker build -f Dockerfile.test.backend -t idp-test-backend .
#     docker run --rm -v "$PWD":/var/www idp-test-backend
#     docker run --rm -v "$PWD":/var/www idp-test-backend php artisan test --filter=AuditList
#
# Immagine leggera di proposito: qui non servono nginx, supervisor, php-fpm o node. `pdo_mysql`
# c'e' lo stesso, perche' capita di voler eseguire la stessa suite contro `idp_test` per provare
# qualcosa che sqlite non riproduce.

FROM php:8.2-cli

WORKDIR /var/www

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    libzip-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# `pdo_sqlite` e `sqlite3` sono compilati di serie nell'immagine ufficiale: sono il modo 1.

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Il .env dei test: preparato QUI, dentro l'immagine, a partire dal modello versionato.
# Non tocca il .env dell'host, e non viene toccato da lui: il codice si monta a runtime, ma le
# variabili che contano arrivano dall'ambiente del container, che vince su qualunque file .env
# e su `phpunit.xml` (verificato il 2026-08-12).
COPY .env.test.backend.example /opt/test/.env

COPY docker/test/entrypoint.sh /usr/local/bin/entrypoint-test.sh
RUN chmod +x /usr/local/bin/entrypoint-test.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-test.sh"]
CMD ["php", "artisan", "test"]
