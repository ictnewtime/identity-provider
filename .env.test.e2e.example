# Variabili dei test E2E (Cypress). Modello: si copia e si adatta.
#
#     cp .env.test.e2e.example .env.testing.e2e
#
# Gli E2E usano **MariaDB**, database `idp_test`, e non sqlite. Sono due i motivi, e il primo e'
# misurato: `LIKE '%MARIO'` su una lettera accentata maiuscola trova 0 righe su sqlite e 1 su
# MariaDB con `utf8mb4_unicode_ci` — e la ricerca di questa applicazione e' fatta di `LIKE`, su
# nomi che in italiano hanno gli accenti. Il secondo e' che un browser vero interroga
# un'applicazione viva: sqlite in memoria non sopravvive fra due richieste HTTP.
#
# Decisione D3/D4 del task docs/task/todo/20260812-local-environments/.

APP_ENV=testing

# --- Il database degli E2E ---------------------------------------------------------------------
# Lo crea l'entrypoint dell'ambiente di test con CREATE DATABASE IF NOT EXISTS a ogni avvio:
# non c'e' un passo da ricordare. Il contenuto lo ricreano le migrazioni e il seeder.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=idp_test
DB_USERNAME=root
DB_PASSWORD=123

# --- Il guardiano ------------------------------------------------------------------------------
# `idp_develop` non compare, e non deve: e' il database di chi sviluppa. Se un giorno comparisse,
# `tests/TestCase.php` smetterebbe di essere una difesa.
TEST_ALLOWED_DATABASES=":memory:,idp_test"

# --- Cypress -----------------------------------------------------------------------------------
# Fra container ci si raggiunge per NOME DEL SERVIZIO sulla porta 80: `localhost:8001` e' la porta
# pubblicata sull'host e da dentro non risolve.
CYPRESS_BASE_URL=http://app

# --- Dati di partenza --------------------------------------------------------------------------
# La password dell'amministratore creato da DatabaseSeeder: il seeder non la inventa piu' e senza
# questa variabile si ferma (difetto VDF08).
SEED_ADMIN_PASSWORD=
