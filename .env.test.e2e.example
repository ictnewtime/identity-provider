# Variabili dei test E2E (Playwright). NON si copia a mano: `Dockerfile.test.e2e` lo copia
# nell'immagine come `.env`, e il container lo legge da li'. Il `.env` dell'host non entra mai.
#
#     ./scripts/run-test-e2e.sh
#
# Le credenziali (APP_KEY, password dell'amministratore e degli utenti E2E) qui NON ci sono:
# le genera `docker/test/e2e-entrypoint.sh` a ogni avvio del container, e muoiono con lui.

APP_NAME=IDP
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=http://localhost:8000

# --- Il database degli E2E ---------------------------------------------------------------------
# Un file sqlite in /tmp DENTRO il container: lo ricrea `e2e-reset-db.sh`, sparisce con il
# container. Lo script rifiuta di partire se il database non e' un sqlite in /tmp.
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/e2e/database.sqlite

# Niente servizi esterni: sessioni e cache su file, posta nel log, log sull'uscita del server.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stderr
LOG_LEVEL=warning

TOKEN_COOKIE_DOMAIN=localhost
PROVIDER_DOMAIN=localhost

# --- Playwright --------------------------------------------------------------------------------
# L'applicazione gira nello stesso container: si raggiunge su localhost.
E2E_BASE_URL=http://localhost:8000
