# Ambiente dei test E2E. Si usa con `docker-compose.test.yml`, non da solo: gli E2E hanno bisogno
# di servizi che restano su — l'applicazione e MariaDB — e quello lo esprime il compose.
#
# Differenza da `Dockerfile.test.backend`, che e' la ragione per cui sono due file:
#   - backend  → sqlite in memoria, nessun servizio, un comando basta;
#   - e2e      → MariaDB `idp_test`, vivo per tutta la sessione, piu' un browser.
#
# INCOMPLETO di proposito: qui manca Cypress. All'immagine dell'applicazione mancano tutte le
# librerie che gli servono, e la strada scelta e' l'immagine ufficiale `cypress/included`, non
# installarle a mano — vedi docs/task/todo/20260812-e2e-test-container/. Oggi questa immagine
# prepara il database e sa eseguire la suite PHP contro MariaDB, che e' il pezzo che serve
# **prima** del browser.

FROM php:8.2-cli

WORKDIR /var/www

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    libzip-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Il .env degli E2E: preparato QUI, dentro l'immagine, dal modello versionato. Non tocca il .env
# dell'host e non viene toccato da lui.
COPY .env.test.e2e.example /opt/test/.env

COPY docker/test/entrypoint.sh /usr/local/bin/entrypoint-test.sh
RUN chmod +x /usr/local/bin/entrypoint-test.sh

USER www-data

ENTRYPOINT ["/usr/local/bin/entrypoint-test.sh"]
CMD ["php", "artisan", "test"]
