# Ambiente dei test E2E (Playwright): UN container solo, che contiene tutto e muore con i test.
#
#     ./scripts/run-test-e2e.sh
#
# Dentro lo stesso container girano:
#   - l'applicazione, con `php artisan serve` su 127.0.0.1:8000;
#   - il database, un file **sqlite in /tmp**: nasce all'avvio e sparisce con il container;
#   - Chromium e Playwright, che usano l'applicazione come farebbe una persona.
#
# Il codice NON si monta: si copia nell'immagine. Cosi' il container non scrive niente
# nell'albero del developer, e non legge il suo `.env`, le sue chiavi o la sua cache.
# Cosa resta fuori dalla copia: `Dockerfile.test.e2e.dockerignore`.
#
# Perche' sqlite e non MariaDB: decisione del developer, gli E2E girano in un container solo.
# Il prezzo e' noto: sqlite confronta le lettere accentate senza distinguere maiuscole e
# minuscole solo per l'ASCII, e il test che lo verifica e' segnato `fixme` (vedi docs/TEST.md).

FROM node:24.19.0-bookworm-slim AS node

FROM php:8.2.35-cli

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    COMPOSER_ALLOW_SUPERUSER=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    libzip-dev \
    openssl \
    && docker-php-ext-install -j"$(nproc)" zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# `pdo_sqlite` e' compilato di serie nell'immagine ufficiale di PHP.

# Node dalla sua immagine ufficiale: la versione e' quella scritta sopra, non quella di Debian.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Prima le dipendenze, poi il codice: se cambia solo il codice, questi strati restano in cache.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-autoloader

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund && npx playwright install --with-deps chromium

COPY . .
COPY .env.test.e2e.example .env

# Il container gira con l'uid di chi lo lancia (`--user`): le cartelle in cui l'applicazione
# scrive devono essere scrivibili da chiunque. Sono dell'immagine, non dell'host.
RUN composer dump-autoload --optimize --no-dev \
    && php artisan package:discover --ansi \
    && npm run build \
    && mkdir -p storage/app/keys storage/framework/cache storage/framework/sessions storage/framework/views \
        storage/logs bootstrap/cache \
    && chmod -R a+rwX storage bootstrap/cache

COPY docker/test/e2e-entrypoint.sh docker/test/e2e-reset-db.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/e2e-entrypoint.sh /usr/local/bin/e2e-reset-db.sh

ENTRYPOINT ["/usr/local/bin/e2e-entrypoint.sh"]
