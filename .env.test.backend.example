# Variabili dei test di BACKEND (PHPUnit). Modello: si copia e si adatta.
#
# NON si copia a mano: lo fa lo script, che poi costruisce l'immagine e lancia la suite.
#
#     ./scripts/run-test-backend.sh
#     ./scripts/run-test-backend.sh --filter=Audit
#
# Il file locale si chiama **.env.test.backend** ed e' in .gitignore. E' l'unico nome: fino al
# 2026-08-19 questa intestazione diceva `.env.testing`, che non era ignorato da git e non era letto
# da nessuno — con una credenziale in mezzo, sbagliare file significa metterla dove non serve.
#
# I test di backend girano su **sqlite in memoria**: e' la decisione D3 del task
# docs/task/todo/20260812-local-environments/. Niente servizi, niente attese, database ricreato
# da zero a ogni test. Gli E2E usano invece MariaDB: vedi .env.test.e2e.example.
#
# ATTENZIONE, e' il punto che sorprende: le variabili dichiarate in `phpunit.xml` **vincono** su
# quelle di un file `.env`, perche' PHPUnit le imposta prima che Laravel legga il file e il
# caricatore di Laravel non sovrascrive cio' che c'e' gia'. Per cambiare davvero una variabile
# si esporta nell'ambiente del processo. Verificato il 2026-08-12.
#
# ATTENZIONE 2: con una config cache presente (`bootstrap/cache/config.php`) `env()` e' inerte e
# nulla di tutto questo ha effetto. Difetto VDF11.

APP_ENV=testing

# --- Il database dei test di backend -----------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# --- Il guardiano ------------------------------------------------------------------------------
# Elenco dei database su cui la suite ha il permesso di girare. `tests/TestCase.php` legge la
# configurazione RISOLTA a runtime e **aborta prima di qualunque migrazione** se non e' fra questi.
# `idp_test` resta consentito perche' e' il database degli E2E, e capita di eseguire la suite li'.
# `idp_develop` non c'e' e non deve esserci: e' il database di chi sviluppa.
TEST_ALLOWED_DATABASES=":memory:,idp_test"

# --- Credenziali: dichiarate qui SENZA valore ---------------------------------------------------
# Le righe vuote qui sotto sono un elenco, non una dimenticanza: `scripts/setup-env-for-test-backend.sh`
# **genera** il valore di ognuna e lo scrive in `.env.test.backend`, che git ignora. Nel modello
# versionato non entra mai un valore, ed e' la ragione per cui questo elenco esiste separato dal resto.
#
# Generate e non digitate: sono credenziali di prova, servono a esistere. Quale sia il valore non
# interessa a nessuno — e cosi' non c'e' niente da ricordare, e in CI funziona identico.
#
# SEED_ADMIN_PASSWORD: la usa `DatabaseSeederTest`, che semina un amministratore su sqlite in
# memoria. Il seeder pretende una password e non ne inventa una (difetto VDF08) — questa la inventa
# lo script al posto suo; il test, senza la variabile, si ferma dicendo quale comando la prepara.
SEED_ADMIN_PASSWORD=

# --- Dati di prova -----------------------------------------------------------------------------
# Stanno fuori dal codice perche' un indirizzo IP in un file PHP fa scattare la regola S1313 di
# SonarQube. I valori predefiniti sono in `phpunit.xml`, cosi' la suite funziona su un albero
# appena clonato, senza questo file.
TEST_IP_ADDRESS=127.0.0.1
TEST_IP_ADDRESS_ALT=10.0.0.1
TEST_IP_ADDRESS_OTHER=192.168.1.1
TEST_USER_AGENT=phpunit
