<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="/tmp/phpunit-cache"
>
    <!-- `cacheDirectory` fuori dall'albero, ed e' l'unico modo. Senza questo attributo Pest
         inietta `vendor/pestphp/pest/.temp` come cartella della cache
         (`src/Plugins/Cache.php:47`), e la` il container dei test non scrive: gira con l'utente
         dell'host mentre `vendor/` e' di root. Disattivare la cache non funziona, ed e' la parte
         che sorprende: lo stesso plugin aggiunge l'argomento che la accende, e la riga di comando
         vince sull'XML. Provato: con `cacheResult` a `false` l'avviso restava identico. -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- I log della suite vanno su stderr, non in `storage/logs/laravel.log`. Quel file
             appartiene a **www-data** — lo scrive il container dell'applicazione — e il container
             dei test gira con l'utente dell'host: 255 scritture rifiutate e 13 test rossi, misurati
             il 2026-08-20. Stessa scelta della config cache deviata in `/tmp`: cio' che il test
             scrive non tocca l'albero di chi sviluppa. -->
        <env name="LOG_CHANNEL" value="stderr"/>
        <!-- Modo 1, predefinito: sqlite in memoria. Le variabili d'ambiente VINCONO su queste,
             quindi il modo 2 (MariaDB `idp_test`) si attiva esportandole prima di lanciare la
             suite: vedi .env.test.example e docs/TEST.md. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- Database su cui la suite ha il permesso di girare. Il guardiano in tests/TestCase.php
             aborta se quello configurato non è fra questi: `migrate:fresh` su un database di
             sviluppo lo svuota, ed è già successo (difetto VDF11). -->
        <env name="TEST_ALLOWED_DATABASES" value=":memory:,idp_test"/>
        <!-- Dati di prova. Stanno qui e non nel codice: un indirizzo IP scritto in un file PHP fa
             scattare la regola S1313 di SonarQube, e la regola ha ragione a volerlo configurabile. -->
        <env name="TEST_IP_ADDRESS" value="127.0.0.1"/>
        <env name="TEST_IP_ADDRESS_ALT" value="10.0.0.1"/>
        <env name="TEST_IP_ADDRESS_OTHER" value="192.168.1.1"/>
        <env name="TEST_USER_AGENT" value="phpunit"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
