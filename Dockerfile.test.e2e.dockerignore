# Cosa NON entra nell'immagine degli E2E (vale solo per Dockerfile.test.e2e).
# Le dipendenze e gli asset si ricreano dentro l'immagine; i segreti e lo stato del developer
# non devono arrivarci.
.git/
node_modules/
vendor/
.env
.env.*
!.env.test.e2e.example
storage/*.key
storage/app/keys/
storage/logs/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
bootstrap/cache/*.php
public/build/
public/hot
lang/php_*.json
tests/integration/
e2e-report/
tmp/
.claude/
.vscode/
